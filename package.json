{
  "name": "chatplays",
  "version": "2.9.2",
  "description": "Let Twitch and YouTube chat control emulators, Minecraft, or almost any keyboard-driven game with fully customizable chat controls.",
  "main": "src/index.js",
  "bin": {
    "chatplays": "src/index.js"
  },
  "pkg": {
    "assets": [
      ".env.example",
      "README.md"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node scripts/run-tests.js",
    "setup": "node scripts/setup.js",
    "assistente": "node src/assistente.js",
    "build": "node scripts/build.js"
  },
  "keywords": [
    "chatplays",
    "twitch",
    "youtube",
    "chat-plays",
    "tpp",
    "twitch-plays",
    "pokemon",
    "hold",
    "segurar",
    "bot",
    "gameboy",
    "gba",
    "emulador",
    "nodejs"
  ],
  "author": "SindromeGames",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "tmi.js": "^1.8.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
