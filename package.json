{
  "name": "pokemon-chat-plays",
  "version": "2.1.0",
  "description": "Bot que permite que o chat da Twitch e do YouTube jogue Pokemon (ou outros jogos) enviando comandos no chat. Versao brasileira melhorada do projeto twitch-chat-plays-pokemon, criada para o canal SindromeGames.",
  "main": "src/index.js",
  "bin": {
    "pokemon-chat-plays": "src/index.js"
  },
  "pkg": {
    "assets": [
      ".env.example",
      "README.md"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "echo \"Erro: nenhum teste definido\" && exit 1",
    "setup": "node scripts/setup.js",
    "build": "node scripts/build.js",
    "build:exe": "nexe --build --output dist/PokemonChatPlays.exe --target x86_64-pc-windows-msvc --input src/index.js --resource .env.example --resource README.md",
    "package": "node scripts/package.js"
  },
  "keywords": [
    "pokemon",
    "twitch",
    "youtube",
    "chat-plays",
    "tpp",
    "bot",
    "gameboy",
    "gba",
    "emulador",
    "nodejs"
  ],
  "author": "SindromeGames",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "tmi.js": "^1.8.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
