# ============================================================
# Configuração do ChatPlays
# ============================================================
# Dica: nao precisa editar este arquivo na mao — abra o iniciar.bat
# que o assistente de configuracao abre no navegador ja preenchido.
# Nunca compartilhe seu arquivo .env publicamente!
# ============================================================

# ----- TWITCH -----
# Nome de usuário do seu bot na Twitch (geralmente uma segunda conta)
TWITCH_BOT_USERNAME=seu_bot_aqui

# Token OAuth do bot - gere em: https://twitchtokengenerator.com/
# COMO GERAR:
#   1. Acesse twitchtokengenerator.com (logado com a conta do seu bot)
#   2. Clique em "Bot Chat Token" (o card do robô verde)
#   3. Clique em "Generate Token!" e autorize a aplicacao
#   4. Na tela de resultado, copie o campo "Access token"
#
# FORMATO: o token pode ser colado de duas formas:
#   - Com prefixo:  oauth:abcd1234efgh5678...
#   - Sem prefixo:  abcd1234efgh5678...
# O bot detecta automaticamente e adiciona o prefixo se faltar.
#
# NOTA: o twitchtokengenerator.com tambem mostra "Refresh token" e "Client ID"
#       mas voce so precisa do "Access token" para este bot.
TWITCH_OAUTH_TOKEN=oauth:seu_token_aqui

# Nome do canal que o bot vai monitorar (sem o #)
TWITCH_CHANNEL=sindromegames

# ----- YOUTUBE -----
# Ative o suporte ao YouTube (true/false)
YOUTUBE_ENABLED=false

# Chave de API do YouTube - crie em: https://console.cloud.google.com/
YOUTUBE_API_KEY=sua_chave_aqui

# ID do vídeo da live do YouTube (a parte depois de v= na URL)
# Exemplo: na URL https://www.youtube.com/watch?v=ABC123XYZ o ID é ABC123XYZ
YOUTUBE_VIDEO_ID=ID_DO_VIDEO_DA_LIVE

# ----- CONFIGURAÇÕES GERAIS -----
# Plataformas ativas (separadas por vírgula): twitch,youtube
ACTIVE_PLATFORMS=twitch

# Cooldown entre comandos por usuário (em milissegundos)
COMMAND_COOLDOWN_MS=1500

# Opcional: cooldown extra por ação. Formato comando=tempo, separado por vírgula.
# O específico só bloqueia repetir aquela ação; outras voltam após o cooldown base.
# Exemplos: dialogo=10s, mouse-click=2s, a=500ms, hold=3s, gamepad=1s
COMMAND_COOLDOWNS=

# Tempo que cada tecla fica pressionada (em milissegundos)
KEY_PRESS_DURATION_MS=230

# Enviar anúncio automático dos comandos a cada N minutos (0 = desativado)
ANNOUNCE_INTERVAL_MIN=10

# Ativar estatísticas de uso (true/false)
ENABLE_STATS=true

# Ativar logs de debug (true/false)
DEBUG=false

# Prefixo para comandos administrativos (ex: !comandos, !ajuda)
ADMIN_PREFIX=!

# ----- SEGURAR TECLAS (hold) - novo na v2.2 -----
# Tempo padrão quando o chat manda "hold cima" sem especificar (em ms)
HOLD_DEFAULT_MS=1000

# Tempo máximo que qualquer hold pode ficar ativo: tecla, botão do mouse
# ou gamepad (1ms é o mínimo aceito; 10000 = 10s)
HOLD_MAX_MS=10000

# Confirmar no chat quando alguém segura/solta teclas (true/false)
# Em chats muito movimentados, pode desativar para menos mensagens do bot
CONFIRM_COMMANDS=true

# ============================================================
# NOVIDADES DA v2.3
# ============================================================

# ----- MODELO DE CONTROLES (ponto de partida) -----
# Layout inicial dos controles embutidos (Game Boy clássico):
#   vbam      -> VisualBoyAdvance-M (padrão do projeto)
#   mgba      -> mGBA
#   desmume   -> DeSmuME (L=Q, R=W, Select=Shift)
#   retroarch -> RetroArch (L=Q, R=W, Select=Shift)
# Os controles COMPLETOS (tecla + palavras do chat + controles
# personalizados) são configurados no assistente e salvos em
# dados/controles.json — que tem prioridade sobre este .env.
EMULADOR_PRESET=vbam

# ----- CONTROLES DO CHAT (v2.9) -----
# Arquivo do registro de controles (o assistente edita por lá).
# Sem esse arquivo, vale EMULADOR_PRESET + TECLA_* abaixo (compatível
# com todas as versões antigas).
CONTROLES_ARQUIVO=dados/controles.json

# ----- MODO JANELA (v2.4): o chat controla SÓ o jogo -----
# Caminho do .exe do jogo/emulador. Com ele definido, as teclas do chat vão
# DIRETO para a janela dele (sem precisar de foco) — você fica
# livre mexendo no OBS sem as teclas vazarem para lá.
# Serve qualquer jogo/emulador. Para Minecraft Java, configure
# EMULADOR_PRESET=minecraft e coloque aqui o LAUNCHER. O ATLauncher é
# automatizado: o bot abre/reutiliza, entra em Instances e aperta Play.
# Deixe VAZIO para o bot perguntar no terminal ao iniciar.
# EMULADOR_EXE=C:\Users\Admin\AppData\Roaming\ATLauncher\ATLauncher.exe

# ----- GERENCIADOR DE JOGO (v2.7): abre, vigia e REABRE o jogo -----
# Com EMULADOR_EXE definido, o bot:
#   - ABRE o jogo sozinho no boot (se ainda não estiver rodando);
#   - se o jogo JÁ estiver aberto, só vigia (não abre uma 2ª instância);
#   - se o jogo FECHAR no meio da live, reabre com a MESMA ROM.
# JOGO_ROM: caminho da ROM passada ao emulador (vazio = jogos sem ROM,
#           como Minecraft)
# JOGO_ROM=C:\Users\Admin\Downloads\Pokemon - Esmeralda.gba
JOGO_ROM=

# Reabrir o jogo sozinho se fechar/cair (false = não reabre)
JOGO_AUTO_REINICIAR=true

# Espera antes de reabrir (ms)
JOGO_REINICIAR_DELAY_MS=3000

# Anti crash-loop: se o jogo morrer "na hora" (menos de JOGO_VIDA_MINIMA_MS)
# este número de vezes SEGUIDAS, o bot desiste e avisa (ROM errada, exe
# quebrado...). Uma rodada que viveu mais reseta a contagem.
JOGO_TENTATIVAS_MAX=5
JOGO_VIDA_MINIMA_MS=15000

# Argumentos extras ao abrir (ex.: RetroArch precisa de "-L caminho\core.dll")
JOGO_ARGS=

# janela (padrão) = teclas vão SÓ para o emulador
# global          = comportamento antigo (teclas vão para a janela em foco)
# Use global se o seu emulador não responde no modo janela (ex.: RetroArch)
MODO_TECLADO=janela

# ----- MOUSE DO CHAT -----
# Comandos: mouse cima/baixo/esquerda/direita, mouse 50 50,
# olhar cima/baixo/esquerda/direita (look up/down/left/right),
# clique/click e clique direito/right click.
# HOLD real de botão (v3.1): hold clique 3s · hold clique direito 2.5s ·
# segurar botao esquerdo 250ms · hold mouse left 500ms (1ms a 10s).
# janela = envia mouse direto para a janela do jogo sem mexer no cursor real
# jogo  = foca o jogo e usa movimento relativo + SendInput (Minecraft/jogos 3D)
# global = mexe/clica no cursor real do Windows (modo clássico)
# off    = desativa todos os comandos de mouse
# Minecraft: prefira jogo. Se a câmera ainda ignorar, desative Raw Input no
# próprio Minecraft e não execute o jogo como administrador.
# Se MODO_MOUSE ficar vazio/ausente, ele acompanha MODO_TECLADO.
MODO_MOUSE=janela

# Intensidade de cada "mouse cima/baixo/esquerda/direita". Em janela/global
# são pixels na área cliente; em jogo são unidades de movimento relativo.
MOUSE_PASSO_PX=40

# ----- GAMEPAD VIRTUAL (Windows / ViGEmBus) -----
# auto = cria no primeiro comando pad | on = prepara no boot | off = desativa
# HOLD de gamepad (v3.1): hold pad a 250ms · hold pad rt 75 500ms ·
# hold pad ls direita 2s · hold pad a 3 (número puro = segundos)
# O instalador/ZIP já trazem ViGEmClient.dll (x64) e o driver em drivers\
GAMEPAD_ENABLED=auto
# Opcional: caminho da ViGEmClient.dll. Vazio = usa a DLL ao lado do app.
GAMEPAD_VIGEM_DLL=
# Durações padrão de botão e analógico/gatilho (ms)
GAMEPAD_TAP_MS=220
GAMEPAD_ANALOG_MS=320

# ============================================================
# NOVIDADES DA v2.5
# ============================================================

# ----- MODO DEMOCRACIA / ANARQUIA (votação estilo Twitch Plays) -----
# anarquia  = padrão: todo comando do chat executa na hora
# democracia = o chat VOTA (janelas de VOTACAO_INTERVALO_MS) e só o
#              comando mais votado é executado no fim de cada janela
# !democracia / !anarquia são votos de modo: precisa maioria real dos
# votos recentes (mín. 2 pessoas). A tecla do streamer F8 troca na hora.
MODO_INICIAL=anarquia

# Duração de cada janela de votação em democracia (em ms, mínimo 2000)
VOTACAO_INTERVALO_MS=10000

# Intervalo mínimo entre trocas aprovadas pela maioria DO CHAT (anti
# flip-flop, em ms; o streamer com F8 troca na hora)
VOTACAO_TROCA_MIN_MS=30000

# Tecla do streamer que alterna anarquia/democracia ('off' desativa)
TECLA_MODO=f8

# ----- SAVES DO CHAT (voltar no tempo) -----
# "salvar" e "carregar" viraram botões do chat (savestates do emulador).
# Padrão do VBA-M/mGBA/DeSmuME: slot 5 (F5 carrega, Shift+F5 salva).
# Aceita COMBOS: shift+f5, ctrl+alt+f2... (RetroArch: f2/f4 já simples)
# TECLA_SALVAR=shift+f5
# TECLA_CARREGAR=f5

# ----- TECLA DE PAUSA CONFIGURÁVEL -----
# Tecla global do streamer que pausa/libera o chat (padrão f9).
# Dica: o VBA-M usa F1-F10 para savestates — se você usa os saves do
# emulador manualmente, escolha uma tecla que ele não use.
TECLA_PAUSA=f9

# ----- TECLAS CUSTOMIZÁVEIS (sobrescrevem o preset) -----
# Nomes aceitos: up, down, left, right, enter, backspace, space, tab,
# esc, shift, f1-f12, COMBOS (shift+f5) e letras/dígitos (a-z, 0-9).
# Deixe vazio para usar o preset.
# ⚠️ v2.9: se você salvar controles no assistente (dados/controles.json),
# eles têm prioridade sobre estas chaves — o arquivo é a fonte da verdade.
# Descomente e ajuste o que quiser:
# TECLA_A=x
# TECLA_B=z
# TECLA_L=a
# TECLA_R=s
# TECLA_START=enter
# TECLA_SELECT=backspace
# TECLA_UP=up
# TECLA_DOWN=down
# TECLA_LEFT=left
# TECLA_RIGHT=right

# ----- STATS PERSISTENTES -----
# Salva o ranking e os totais em arquivo: sobrevivem a restarts,
# o !top passa a valer por live inteira.
STATS_PERSISTENTES=true

# Onde salvar (relativo à pasta do app)
STATS_ARQUIVO=dados/stats.json

# ----- OVERLAY DO OBS -----
# Painel ao vivo para colocar na stream: últimas ações, top 3 jogadores,
# teclas seguradas e aviso de pausa. No OBS: Fontes -> + -> Navegador ->
# cole http://localhost:8899
# Diagnóstico local do bot: http://localhost:8899/dashboard
OVERLAY_ATIVA=true
OVERLAY_PORTA=8899

# ----- AVISO DE ATUALIZAÇÃO -----
# No startup, checa no GitHub se saiu versão nova e avisa no terminal.
VERIFICAR_ATUALIZACAO=true
