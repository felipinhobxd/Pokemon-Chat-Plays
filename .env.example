# ============================================================
# Configuração do Pokemon Chat Plays
# ============================================================
# Copie este arquivo para ".env" e preencha com seus dados.
# Nunca compartilhe seu arquivo .env publicamente!
# ============================================================

# ----- TWITCH -----
# Nome de usuário do seu bot na Twitch (geralmente uma segunda conta)
TWITCH_BOT_USERNAME=seu_bot_aqui

# Token OAuth do bot - gere em: https://twitchtokengenerator.com/
# COMO GERAR:
#   1. Acesse twitchtokengenerator.com (logado com a conta do seu bot)
#   2. Clique em "Bot Chat Token" (o card do robô verde)
#   3. Clique em "Generate Token!" e autorize a aplicacao
#   4. Na tela de resultado, copie o campo "Access token"
#
# FORMATO: o token pode ser colado de duas formas:
#   - Com prefixo:  oauth:abcd1234efgh5678...
#   - Sem prefixo:  abcd1234efgh5678...
# O bot detecta automaticamente e adiciona o prefixo se faltar.
#
# NOTA: o twitchtokengenerator.com tambem mostra "Refresh token" e "Client ID"
#       mas voce so precisa do "Access token" para este bot.
TWITCH_OAUTH_TOKEN=oauth:seu_token_aqui

# Nome do canal que o bot vai monitorar (sem o #)
TWITCH_CHANNEL=sindromegames

# ----- YOUTUBE -----
# Ative o suporte ao YouTube (true/false)
YOUTUBE_ENABLED=false

# Chave de API do YouTube - crie em: https://console.cloud.google.com/
YOUTUBE_API_KEY=sua_chave_aqui

# ID do vídeo da live do YouTube (a parte depois de v= na URL)
# Exemplo: na URL https://www.youtube.com/watch?v=ABC123XYZ o ID é ABC123XYZ
YOUTUBE_VIDEO_ID=ID_DO_VIDEO_DA_LIVE

# ----- CONFIGURAÇÕES GERAIS -----
# Plataformas ativas (separadas por vírgula): twitch,youtube
ACTIVE_PLATFORMS=twitch

# Cooldown entre comandos por usuário (em milissegundos)
COMMAND_COOLDOWN_MS=1500

# Tempo que cada tecla fica pressionada (em milissegundos)
KEY_PRESS_DURATION_MS=230

# Enviar anúncio automático dos comandos a cada N minutos (0 = desativado)
ANNOUNCE_INTERVAL_MIN=10

# Ativar estatísticas de uso (true/false)
ENABLE_STATS=true

# Ativar logs de debug (true/false)
DEBUG=false

# Prefixo para comandos administrativos (ex: !comandos, !ajuda)
ADMIN_PREFIX=!

# ----- SEGURAR TECLAS (hold) - novo na v2.2 -----
# Tempo padrão quando o chat manda "hold cima" sem especificar (em ms)
HOLD_DEFAULT_MS=1000

# Tempo máximo que uma tecla pode ficar presa (em ms)
HOLD_MAX_MS=10000

# Confirmar no chat quando alguém segura/solta teclas (true/false)
# Em chats muito movimentados, pode desativar para menos mensagens do bot
CONFIRM_COMMANDS=true
